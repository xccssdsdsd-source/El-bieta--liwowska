{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elzbieta-sliwowska",
  "main": "./src/worker.js",
  "compatibility_date": "2026-07-29",
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
